# Copy this file to .env and fill in your token:  cp .env.example .env
#
# Webflow API token.
#   - CMS:read  is enough for: locales, collections, items, status
#   - CMS:write is required for: delete
# Create one in Webflow: Site settings -> Apps & integrations -> API access.
# Keep it secret. .env is gitignored — never commit a real token.
WEBFLOW_TOKEN=

# Optional: pin a site by name or id so you can never touch the wrong one.
# WEBFLOW_SITE=Anytime Fitness
